# PARTE 1: VERIFICADOR DE LOTERÍA
# ═══════════════════════════════════════════════════════════════════════════════

"""
Un sistema de lotería tiene números ganadores y diferentes boletos.

En esta parte utilizamos los conjuntos normales de Python.

Operaciones importantes:

A & B  → Intersección
         Elementos que están en A Y en B.

A - B  → Diferencia
         Elementos que están en A pero NO en B.

A | B  → Unión
         Todos los elementos de A y B sin repetir.
"""


# Números ganadores de la lotería
numeros_ganadores = {7, 14, 21, 28, 35, 42}

# Boletos de los participantes
boleto_ana = {7, 12, 21, 33, 42, 45}
boleto_luis = {3, 14, 28, 35, 40, 42}
boleto_sara = {1, 8, 15, 22, 29, 36}


# ═══════════════════════════════════════════════════════════════════════════════
# PUNTO 1.1: ACIERTOS DE UN BOLETO
# ═══════════════════════════════════════════════════════════════════════════════

def aciertos(boleto):
    """
    Retorna los números que aparecen tanto en el boleto como
    en los números ganadores.

    Esto es una INTERSECCIÓN.

    Ejemplo:

    boleto_ana = {7, 12, 21, 33, 42, 45}
    ganadores = {7, 14, 21, 28, 35, 42}

    Resultado:
    {7, 21, 42}

    El símbolo & representa la intersección en Python.
    """

    return boleto & numeros_ganadores


# ═══════════════════════════════════════════════════════════════════════════════
# PUNTO 1.2: NÚMEROS FALTANTES
# ═══════════════════════════════════════════════════════════════════════════════

def numeros_faltantes(boleto):
    """
    Retorna los números ganadores que NO estaban en el boleto.

    Esto es una DIFERENCIA.

    La pregunta que debemos hacernos es:

    ¿Qué números están en los ganadores pero no están en el boleto?

    Por eso hacemos:

    numeros_ganadores - boleto
    """

    return numeros_ganadores - boleto


# ═══════════════════════════════════════════════════════════════════════════════
# PUNTO 1.3: NÚMEROS QUE NADIE ACERTÓ
# ═══════════════════════════════════════════════════════════════════════════════

def sin_acertar_nadie():
    """
    Retorna los números ganadores que no aparecen en ninguno
    de los tres boletos.

    Primero hacemos una UNIÓN de todos los boletos.

    Después hacemos una DIFERENCIA:

    ganadores - todos_los_boletos

    De esta manera obtenemos los números ganadores que nadie tenía.
    """

    # Juntamos los números de Ana y Luis
    union_de_boletos = boleto_ana | boleto_luis

    # Agregamos los números del boleto de Sara
    union_de_boletos = union_de_boletos | boleto_sara

    # Quitamos de los ganadores los números que aparecieron en algún boleto
    ningun_acierto = numeros_ganadores - union_de_boletos

    return ningun_acierto


