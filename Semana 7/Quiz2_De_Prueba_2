# PARTE 2: CATÁLOGO DE BIBLIOTECA
# ═══════════════════════════════════════════════════════════════════════════════

"""
En esta parte NO usamos los conjuntos normales de Python.

Utilizamos nuestra propia clase Conjunto, que funciona mediante
una lista enlazada.

La estructura es:

cabeza
   ↓
┌───────┐     ┌───────┐     ┌───────┐
│ dato  │ --> │ dato  │ --> │ dato  │ --> None
└───────┘     └───────┘     └───────┘

Para recorrerla utilizamos:

actual = conjunto.cabeza

while actual:
    ...
    actual = actual.siguiente
"""


# ═══════════════════════════════════════════════════════════════════════════════
# CÓDIGO BASE
# ═══════════════════════════════════════════════════════════════════════════════

class Nodo:

    def __init__(self, dato):
        # Guarda el dato del nodo
        self.dato = dato

        # Guarda la referencia al siguiente nodo
        self.siguiente = None


class Conjunto:

    def __init__(self, elementos=None):

        # Al comenzar, el conjunto no tiene nodos
        self.cabeza = None

        # Cantidad de elementos
        self.tamaño = 0

        # Si recibimos elementos, los agregamos uno por uno
        if elementos:
            for e in elementos:
                self.agregar(e)

    def esta_vacio(self):
        """
        Retorna True si el conjunto está vacío.
        """

        return self.cabeza is None

    def pertenece(self, x):
        """
        Retorna True si x pertenece al conjunto.

        Recorremos todos los nodos buscando el dato.
        """

        actual = self.cabeza

        while actual:

            if actual.dato == x:
                return True

            # Pasamos al siguiente nodo
            actual = actual.siguiente

        # Si terminamos el recorrido y no encontramos el dato
        return False

    def agregar(self, x):
        """
        Agrega x al conjunto si todavía no existe.
        """

        # Primero verificamos si ya existe
        if self.pertenece(x):
            return False

        # Creamos un nuevo nodo
        nuevo = Nodo(x)

        # El nuevo nodo apunta a la antigua cabeza
        nuevo.siguiente = self.cabeza

        # Ahora el nuevo nodo se convierte en la cabeza
        self.cabeza = nuevo

        # Aumentamos el tamaño
        self.tamaño += 1

        return True

    def __str__(self):
        """
        Permite mostrar el conjunto utilizando print().
        """

        elementos = []

        actual = self.cabeza

        while actual:

            elementos.append(str(actual.dato))

            actual = actual.siguiente

        return "{" + ", ".join(elementos) + "}"


# ═══════════════════════════════════════════════════════════════════════════════
# PUNTO 2.1: LIBROS EN AMBAS BIBLIOTECAS
# ═══════════════════════════════════════════════════════════════════════════════

def libros_en_ambas(biblio_a, biblio_b):
    """
    Retorna un NUEVO Conjunto con los libros que están en ambas bibliotecas.

    Esto representa una INTERSECCIÓN.

    Pasos:

    1. Crear un conjunto vacío para guardar el resultado.
    2. Recorrer biblio_a desde su cabeza.
    3. Preguntar si cada libro también pertenece a biblio_b.
    4. Si pertenece, agregarlo al resultado.
    5. Pasar al siguiente nodo.
    6. Retornar el resultado.
    """

    # Conjunto donde guardaremos los libros en común
    resultado = Conjunto()

    # Comenzamos a recorrer la biblioteca A
    actual = biblio_a.cabeza

    while actual:

        # Preguntamos si el libro también está en la biblioteca B
        if biblio_b.pertenece(actual.dato):

            # Si está, lo agregamos al resultado
            resultado.agregar(actual.dato)

        # Pasamos al siguiente libro
        actual = actual.siguiente

    return resultado


# ═══════════════════════════════════════════════════════════════════════════════
# PUNTO 2.2: LIBROS EXCLUSIVOS
# ═══════════════════════════════════════════════════════════════════════════════

def libros_exclusivos(biblio_a, biblio_b):
    """
    Retorna un NUEVO Conjunto con los libros que están en A
    pero NO están en B.

    Esto representa una DIFERENCIA.

    Pasos:

    1. Crear un conjunto vacío.
    2. Recorrer A.
    3. Preguntar si el libro NO pertenece a B.
    4. Si no pertenece, agregarlo al resultado.
    5. Pasar al siguiente nodo.
    6. Retornar el resultado.
    """

    # Conjunto donde guardaremos los libros exclusivos
    resultado = Conjunto()

    # Comenzamos en la cabeza de A
    actual = biblio_a.cabeza

    while actual:

        # Si el libro NO está en B, es exclusivo de A
        if not biblio_b.pertenece(actual.dato):

            resultado.agregar(actual.dato)

        # Pasamos al siguiente libro
        actual = actual.siguiente

    return resultado


# ═══════════════════════════════════════════════════════════════════════════════
# PUNTO 2.3: VERIFICAR SI UNA BIBLIOTECA CONTIENE TODOS LOS LIBROS
# ═══════════════════════════════════════════════════════════════════════════════

def contiene_todos(biblio_grande, biblio_chica):
    """
    Retorna True si biblio_grande contiene TODOS los libros
    de biblio_chica.

    Es decir:

    biblio_chica ⊆ biblio_grande

    Pasos:

    1. Recorrer biblio_chica.
    2. Preguntar si cada libro pertenece a biblio_grande.
    3. Si encontramos uno que NO pertenece, retornamos False.
    4. Si terminamos todo el recorrido sin encontrar faltantes,
       retornamos True.

    IMPORTANTE:

    No necesitamos crear un conjunto de resultados porque aquí
    solamente queremos saber si se cumple una condición.
    """

    # Comenzamos a recorrer la biblioteca chica
    actual = biblio_chica.cabeza

    while actual:

        # Si encontramos un libro que la biblioteca grande NO tiene,
        # entonces ya sabemos que no contiene todos los libros.
        if not biblio_grande.pertenece(actual.dato):

            return False

        # El libro sí estaba, así que seguimos con el siguiente
        actual = actual.siguiente

    # Terminamos el recorrido y ningún libro faltó
    return True


